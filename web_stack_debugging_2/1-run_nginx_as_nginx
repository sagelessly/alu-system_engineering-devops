#!/usr/bin/env bash
# Runs nginx as the nginx user, listening on port 8080
pkill nginx
sed -Ei 's/^#?user .*/user nginx;/' /etc/nginx/nginx.conf
sed -Ei 's/listen 80 /listen 8080 /; s/listen \[::\]:80 /listen [::]:8080 /' /etc/nginx/sites-enabled/default
chown -R nginx:nginx /var/log/nginx /var/lib/nginx
touch /run/nginx.pid
chown nginx:nginx /run/nginx.pid
sudo -u nginx nginx
